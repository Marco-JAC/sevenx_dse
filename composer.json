{
    "name": "se7enxweb/sevenx_dse",
    "description": "7x Database Source Editor for Exponential: AdminNeo embedded in the administration as a permission-gated database editor (browse and edit tables, run SQL, inspect and change the schema, import and export) for MySQL/MariaDB, PostgreSQL, SQLite and the other AdminNeo drivers.",
    "keywords": [ "exponential", "exponential-legacy", "legacy-extension", "database editor", "adminneo", "adminer", "database management", "sql", "mysql", "mariadb", "postgresql", "sqlite" ],
    "homepage": "https://github.com/se7enxweb/sevenx_dse",
    "support": {
        "issues": "https://github.com/se7enxweb/sevenx_dse/issues",
        "source": "https://github.com/se7enxweb/sevenx_dse"
    },
    "license": "GPL-2.0-or-later",
    "type": "ezpublish-legacy-extension",
    "authors": [
        {
            "name": "7x",
            "homepage": "https://se7enx.com",
            "email": "info@se7enx.com",
            "role": "Author and maintainer"
        },
        {
            "name": "Peter Knut",
            "role": "AdminNeo author"
        },
        {
            "name": "Jakub Vrána",
            "homepage": "https://www.vrana.cz/",
            "role": "Adminer author"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "se7enxweb/exponential-legacy-installer": "*"
    },
    "require-dev": {
        "vrana/jush": "@dev",
        "vrana/jsshrink": "@dev",
        "vrana/phpshrink": "@dev"
    },
    "suggest": {
        "ext-openssl": "Allows secure encryption of login information",
        "ext-zlib": "Allows gzip compression of data export",
        "ext-bz2": "Allows bzip2 compression of data export",
        "ext-zip": "Allows ZIP compression of data export",
        "ext-mysqli": "Allows access to MySQL and MariaDB databases",
        "ext-pgsql": "Allows access to PostgreSQL databases",
        "ext-mongodb": "Allows access to MongoDB databases",
        "ext-sqlsrv": "Allows access to MS SQL databases",
        "ext-sqlite3": "Allows access to SQLite databases",
        "ext-oci8": "Allows access to Oracle databases",
        "ext-simplexml": "Allows access to SimpleDB databases",
        "ext-libxml": "Allows processing responses from SimpleDB databases",
        "ext-pdo": "PDO database interface",
        "ext-pdo_pgsql": "PDO driver for PostgreSQL databases",
        "ext-pdo_dblib": "PDO driver for MS SQL and Sybase databases",
        "ext-pdo_sqlite": "PDO driver for SQLite databases",
        "ext-pdo_oci": "PDO driver for Oracle databases"
    },
    "extra": {
        "installer-name": "sevenx_dse",
        "ezpublish-legacy-extension-name": "sevenx_dse"
    }
}
